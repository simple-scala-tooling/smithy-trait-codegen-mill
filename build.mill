//| mill-version: 1.1.6
//| mvnDeps:
//| - com.goyeau::mill-git::0.3.2

package build

import com.goyeau.mill.git.GitVersionedPublishModule
import mill.*
import mill.scalalib.*
import mill.scalalib.publish.*

object smithyTraitCodegen extends ScalaModule, SonatypeCentralPublishModule, GitVersionedPublishModule {

  def artifactName = "smithy-trait-codegen-mill"

  def scalaVersion = "3.8.3"

  def platformSuffix = "_mill1"

  def mvnDeps = Seq(
    mvn"software.amazon.smithy:smithy-model:1.70.0",
    mvn"software.amazon.smithy:smithy-build:1.70.0",
    mvn"software.amazon.smithy:smithy-trait-codegen:1.70.0",
  )

  def compileMvnDeps = super.compileMvnDeps() ++ Seq(
    mvn"com.lihaoyi::mill-libs-scalalib:${mill.api.BuildInfo.millVersion}",
  )

  def pomSettings = PomSettings(
    description = "Smithy Trait Codegen Mill Plugin",
    organization = "io.github.simple-scala-tooling",
    url = "https://github.com/simple-scala-tooling/smithy-trait-codegen-mill",
    licenses = Seq(License.MIT),
    versionControl = VersionControl.github("simple-scala-tooling", "smithy-trait-codegen-mill"),
    developers = Seq(Developer("lihaoyi", "Li Haoyi", "https://github.com/lihaoyi"))
  )
}
